# =============================================================================
# AI CFO — Environment Variables Template
# Copy this to .env and fill in real values. NEVER commit .env to git.
# =============================================================================

# Application
APP_NAME=ai-cfo
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://aicfo:aicfo_dev_password@localhost:5432/aicfo
DATABASE_URL_SYNC=postgresql://aicfo:aicfo_dev_password@localhost:5432/aicfo

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Auth
JWT_SECRET_KEY=CHANGE-ME-TO-A-RANDOM-64-CHAR-STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption (for connector credentials)
ENCRYPTION_KEY=CHANGE-ME-TO-A-32-BYTE-BASE64-KEY

# Stripe (test mode)
STRIPE_TEST_API_KEY=sk_test_...

# Plaid (sandbox)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Observability
SENTRY_DSN=
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
